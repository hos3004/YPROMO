{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YPROMO",
  "version": "0.1.0",
  "identifier": "com.hos3004.ypromo",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist-renderer"
  },
  "app": {
    "windows": [
      {
        "title": "YPROMO",
        "width": 1440,
        "height": 920,
        "minWidth": 1120,
        "minHeight": 720
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
